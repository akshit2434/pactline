PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Optional: a sandbox PERSONAL account, used only by scripts/ to approve funding automatically in tests
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Optional: switch on Claude for contract compiling and the evidence judge (claude-haiku-5-5, effort high)
ANTHROPIC_API_KEY=
# PACTLINE_AI_MODEL=claude-haiku-5-5  PACTLINE_AI_EFFORT=high  (override model / effort for every Claude call)
# Optional: webhook id from the PayPal dashboard (enables signature verification)
PAYPAL_WEBHOOK_ID=
# PORT=3100  PAYPAL_MODE=auto|live|mock  PUBLIC_BASE_URL=http://127.0.0.1:3100
